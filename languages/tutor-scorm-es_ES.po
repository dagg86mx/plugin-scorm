msgstr "Lección completada"

msgid "Launch course"
msgstr "Iniciar curso"

msgid "Open course again"
msgstr "Abrir el curso de nuevo"

msgid "The course is open in a new window. Keep this page open to save your progress."
msgstr "El curso está abierto en una ventana nueva. Mantén esta página abierta para guardar tu progreso."

msgid "Your browser blocked the course window. Allow pop-ups for this site and try again."
msgstr "Tu navegador bloqueó la ventana del curso. Permite las ventanas emergentes para este sitio e inténtalo de nuevo."

msgid "Previous"
msgstr "Anterior"

msgid "Next"
msgstr "Siguiente"

msgid "Full screen"
msgstr "Pantalla completa"

msgid "Exit full screen"
msgstr "Salir de pantalla completa"

msgid "Preview mode: progress is not saved."
msgstr "Modo vista previa: el progreso no se guarda."

msgid "Log in to save your progress."
msgstr "Inicia sesión para guardar tu progreso."

