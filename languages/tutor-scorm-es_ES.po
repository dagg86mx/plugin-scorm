msgid "Tutor LMS must be active to import courses."
msgstr "Tutor LMS debe estar activo para importar cursos."

msgid "The outline file %1$s is not valid: %2$s"
msgstr "El archivo de estructura %1$s no es válido: %2$s"

msgid "No outline file (outline.csv or outline.json) and no SCORM packages were found in the ZIP."
msgstr "El ZIP no contiene un archivo de estructura (outline.csv u outline.json) ni paquetes SCORM."

msgid "No outline file was found: one lesson was created for each SCORM package in the ZIP."
msgstr "No se encontró archivo de estructura: se creó una lección por cada paquete SCORM del ZIP."

msgid "The selected course does not exist."
msgstr "El curso seleccionado no existe."

msgid "Imported SCORM course"
msgstr "Curso SCORM importado"

msgid "No SCORM package was specified for this lesson."
msgstr "No se indicó paquete SCORM para esta lección."

msgid "The SCORM package \"%s\" was not found in the ZIP."
msgstr "No se encontró el paquete SCORM «%s» en el ZIP."

msgid "\"%s\" is not a ZIP file or a folder."
msgstr "«%s» no es un archivo ZIP ni una carpeta."

msgid "Import SCORM course"
msgstr "Importar curso SCORM"

msgid "Upload a ZIP that contains an outline file and one SCORM package per lesson. The course, its topics and lessons are created in Tutor LMS and each lesson gets its SCORM package."
msgstr "Sube un ZIP con un archivo de estructura y un paquete SCORM por lección. Se crean en Tutor LMS el curso, sus temas y lecciones, y cada lección recibe su paquete SCORM."

msgid "Course ZIP"
msgstr "ZIP del curso"

msgid "Maximum upload size: %s."
msgstr "Tamaño máximo de subida: %s."

msgid "Select ZIP"
msgstr "Seleccionar ZIP"

msgid "Or a ZIP uploaded by FTP:"
msgstr "O un ZIP subido por FTP:"

msgid "— None —"
msgstr "— Ninguno —"

msgid "For very large courses, upload the ZIP by FTP to %s or use WP-CLI: wp tutor-scorm import-course course.zip"
msgstr "Para cursos muy grandes, sube el ZIP por FTP a %s o usa WP-CLI: wp tutor-scorm import-course curso.zip"

msgid "Destination"
msgstr "Destino"

msgid "Create a new course"
msgstr "Crear un curso nuevo"

msgid "Add to: %s"
msgstr "Añadir a: %s"

msgid "New course status"
msgstr "Estado del curso nuevo"

msgid "Draft (review before publishing)"
msgstr "Borrador (revisar antes de publicar)"

msgid "Published"
msgstr "Publicado"

msgid "Import course"
msgstr "Importar curso"

msgid "ZIP structure"
msgstr "Estructura del ZIP"

msgid "(or outline.json)"
msgstr "(o outline.json)"

msgid "← SCORM exported from your authoring tool"
msgstr "← SCORM exportado desde tu herramienta de autor"

msgid "← or the same SCORM already unzipped (with imsmanifest.xml)"
msgstr "← o el mismo SCORM ya descomprimido (con imsmanifest.xml)"

msgid "outline.csv has one row per lesson. Columns: course, topic, lesson, scorm (path inside the ZIP) and content (optional text shown above the player). Spanish headers (curso, tema, leccion, scorm, contenido) also work. Separate with commas or semicolons."
msgstr "outline.csv tiene una fila por lección. Columnas: curso, tema, leccion, scorm (ruta dentro del ZIP) y contenido (texto opcional que se muestra encima del reproductor). También valen los encabezados en inglés (course, topic, lesson, scorm, content). Separa con comas o punto y coma."

msgid "Download outline.csv template"
msgstr "Descargar plantilla outline.csv"

msgid "Download outline.json template"
msgstr "Descargar plantilla outline.json"

msgid "If the ZIP has no outline file, one lesson is created for each SCORM ZIP or folder found at the top level, in alphabetical order."
msgstr "Si el ZIP no tiene archivo de estructura, se crea una lección por cada ZIP o carpeta SCORM del primer nivel, en orden alfabético."

msgid "Course \"%1$s\": %2$d topic(s) and %3$d lesson(s) imported."
msgstr "Curso «%1$s»: %2$d tema(s) y %3$d lección(es) importados."

msgid "Edit course"
msgstr "Editar curso"

msgid "View course"
msgstr "Ver curso"

msgid "Topic"
msgstr "Tema"

msgid "Lesson"
msgstr "Lección"

msgid "SCORM package"
msgstr "Paquete SCORM"

msgid "Result"
msgstr "Resultado"

msgid "The ZIP is larger than the server allows (post_max_size). Upload it by FTP to wp-content/uploads/tutor-scorm-inbox/ or use WP-CLI."
msgstr "El ZIP supera el tamaño que permite el servidor (post_max_size). Súbelo por FTP a wp-content/uploads/tutor-scorm-inbox/ o usa WP-CLI."

msgid "You are not allowed to import courses."
msgstr "No tienes permiso para importar cursos."

msgid "The ZIP file could not be uploaded. Check the server upload_max_filesize and post_max_size limits."
msgstr "No se pudo subir el archivo ZIP. Revisa los límites upload_max_filesize y post_max_size del servidor."

msgid "Please upload a .zip file."
msgstr "Sube un archivo .zip."

msgid "The selected Media Library file is not a ZIP archive."
msgstr "El archivo seleccionado de la biblioteca de medios no es un ZIP."

msgid "Choose a ZIP file to import."
msgstr "Elige un archivo ZIP para importar."

msgid "SCORM Packages"
msgstr "Paquetes SCORM"

msgid "SCORM Package"
msgstr "Paquete SCORM"

msgid "SCORM"
msgstr "SCORM"

msgid "Add SCORM Package"
msgstr "Añadir paquete SCORM"

msgid "Edit SCORM Package"
msgstr "Editar paquete SCORM"

msgid "New SCORM Package"
msgstr "Nuevo paquete SCORM"

msgid "Search SCORM Packages"
msgstr "Buscar paquetes SCORM"

msgid "No SCORM packages found."
msgstr "No se encontraron paquetes SCORM."

msgid "No SCORM packages found in Trash."
msgstr "No hay paquetes SCORM en la papelera."

msgid "Invalid SCORM manifest: %s"
msgstr "Manifiesto SCORM no válido: %s"

msgid "The manifest references files outside of the package."
msgstr "El manifiesto hace referencia a archivos fuera del paquete."

msgid "Tutor LMS lessons"
msgstr "Lecciones de Tutor LMS"

msgid "SCORM version"
msgstr "Versión SCORM"

msgid "Manifest title"
msgstr "Título del manifiesto"

msgid "Imported"
msgstr "Importado"

msgid "Shortcode"
msgstr "Shortcode"

msgid "Preview"
msgstr "Vista previa"

msgid "Open preview"
msgstr "Abrir vista previa"

msgid "Launchable items"
msgstr "Elementos ejecutables"

msgid "asset"
msgstr "recurso"

msgid "Replace package"
msgstr "Reemplazar paquete"

msgid "Uploading a new version keeps the learners' progress as long as the SCO identifiers do not change."
msgstr "Al subir una nueva versión se conserva el progreso de los estudiantes siempre que no cambien los identificadores de los SCO."

msgid "Upload a ZIP file exported as SCORM 1.2 or SCORM 2004 from your authoring tool (Articulate Storyline/Rise, iSpring, Adobe Captivate, Elucidat, H5P, etc.)."
msgstr "Sube un archivo ZIP exportado como SCORM 1.2 o SCORM 2004 desde tu herramienta de autor (Articulate Storyline/Rise, iSpring, Adobe Captivate, Elucidat, H5P, etc.)."

msgid "Upload ZIP"
msgstr "Subir ZIP"

msgid "Or use a ZIP from the Media Library"
msgstr "O usa un ZIP de la biblioteca de medios"

msgid "Activate Tutor LMS to attach this package to lessons. You can still embed it anywhere with the shortcode."
msgstr "Activa Tutor LMS para asignar este paquete a lecciones. Aun así puedes insertarlo en cualquier lugar con el shortcode."

msgid "(no course)"
msgstr "(sin curso)"

msgid "Select the lessons that should display this package. The player is added below the lesson content and the lesson is completed automatically when the learner finishes the package."
msgstr "Selecciona las lecciones que deben mostrar este paquete. El reproductor se añade debajo del contenido de la lección y la lección se completa automáticamente cuando el estudiante termina el paquete."

msgid "Hold Ctrl (Cmd on Mac) to select several lessons. Alternatively, paste the shortcode into the lesson content from the Tutor course builder."
msgstr "Mantén pulsado Ctrl (Cmd en Mac) para seleccionar varias lecciones. También puedes pegar el shortcode en el contenido de la lección desde el constructor de cursos de Tutor."

msgid "SCORM %1$s package imported with %2$d launchable item(s)."
msgstr "Paquete SCORM %1$s importado con %2$d elemento(s) ejecutable(s)."

msgid "Version"
msgstr "Versión"

msgid "Items"
msgstr "Elementos"

msgid "Lessons"
msgstr "Lecciones"

msgid "SCORM package updated."
msgstr "Paquete SCORM actualizado."

msgid "SCORM package published."
msgstr "Paquete SCORM publicado."

msgid "SCORM package saved."
msgstr "Paquete SCORM guardado."

msgid "SCORM package draft updated."
msgstr "Borrador del paquete SCORM actualizado."

msgid "%d server-side script file was skipped for security reasons."
msgid_plural "%d server-side script files were skipped for security reasons."
msgstr[0] "Se omitió %d archivo de script de servidor por motivos de seguridad."
msgstr[1] "Se omitieron %d archivos de script de servidor por motivos de seguridad."

msgid "Saving…"
msgstr "Guardando…"

