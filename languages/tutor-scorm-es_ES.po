msgstr "Suspendido"

msgid "You are not allowed to preview this package."
msgstr "No tienes permiso para previsualizar este paquete."

msgid "SCORM package not found or not imported yet."
msgstr "Paquete SCORM no encontrado o aún no importado."

msgid "JavaScript is required to play this course."
msgstr "Se necesita JavaScript para reproducir este curso."

msgid "Guest"
msgstr "Invitado"

msgid "SCORM Reports"
msgstr "Informes SCORM"

msgid "SCORM Settings"
msgstr "Ajustes SCORM"

msgid "Select SCORM ZIP"
msgstr "Seleccionar ZIP SCORM"

msgid "Use this file"
msgstr "Usar este archivo"

msgid "Tutor SCORM works best with Tutor LMS. Install and activate Tutor LMS to attach SCORM packages to lessons and complete them automatically."
msgstr "Tutor SCORM funciona mejor con Tutor LMS. Instala y activa Tutor LMS para asignar paquetes SCORM a lecciones y completarlas automáticamente."

msgid "Packages"
msgstr "Paquetes"

msgid "Settings"
msgstr "Ajustes"

msgid "Export CSV"
msgstr "Exportar CSV"

msgid "All packages"
msgstr "Todos los paquetes"

msgid "All statuses"
msgstr "Todos los estados"

msgid "Filter"
msgstr "Filtrar"

msgid "Search learners"
msgstr "Buscar estudiantes"

msgid "You are not allowed to export this report."
msgstr "No tienes permiso para exportar este informe."

